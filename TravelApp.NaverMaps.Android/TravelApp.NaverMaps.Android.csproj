<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>TravelApp.NaverMaps.Android</RootNamespace>
		<AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
	</PropertyGroup>

	<!-- NAVER Maps Android SDK v3.24.0 and its transitive dependencies -->
	<ItemGroup>
		<!-- Main NAVER Maps SDK from NAVER Maven repository -->
		<AndroidMavenLibrary Include="com.naver.maps:map-sdk"
			Version="3.24.0"
			Repository="https://repository.map.naver.com/archive/maven" />
		
		<!-- NAVER geometry library (required by map-sdk) -->
		<AndroidMavenLibrary Include="com.naver.maps:geometry"
			Version="1.3.0"
			Repository="https://repository.map.naver.com/archive/maven" />
	</ItemGroup>

	<!-- AndroidX and other dependencies available as NuGet packages -->
	<ItemGroup>
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.3" />
		<PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.3.2.3" />
		<PackageReference Include="Xamarin.AndroidX.SwipeRefreshLayout" Version="1.1.0.18" />
		<PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.2" />
		<PackageReference Include="Square.OkHttp3" Version="4.12.0.2" />
		<PackageReference Include="GoogleGson" Version="2.11.0.2" />
			<PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="1.9.21.1" />
	</ItemGroup>

	<!-- Additional Java dependencies not available as NuGet -->
	<ItemGroup>
		<AndroidMavenLibrary Include="com.getkeepsafe.relinker:relinker"
			Version="1.4.4"
			Repository="https://repo1.maven.org/maven2/" />
		<AndroidMavenLibrary Include="com.squareup.okhttp3:okhttp-brotli"
			Version="4.10.0"
			Repository="https://repo1.maven.org/maven2/" />
		<AndroidMavenLibrary Include="org.brotli:dec"
			Version="0.1.2"
			Repository="https://repo1.maven.org/maven2/" />
	</ItemGroup>

</Project>

