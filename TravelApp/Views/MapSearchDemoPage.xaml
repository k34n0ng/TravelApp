<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:TravelApp.Controls" x:Class="TravelApp.Views.MapSearchDemoPage" Title="Map Search Demo">
    <VerticalStackLayout Padding="20">
        <Entry Placeholder="Enter place name" Text="{Binding Query}" />
        <Button Text="Search" Command="{Binding SearchCommand}" />
        <Label Text="{Binding Result}" />
        <controls:MapHostView Place="{Binding SelectedPlace}" HeightRequest="400" />
    </VerticalStackLayout>
</ContentPage>
