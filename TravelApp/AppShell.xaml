<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TravelApp"
    xmlns:views="clr-namespace:TravelApp.Views"
    xmlns:pages="clr-namespace:TravelApp.Pages"
    Title="TravelApp">

    <!-- Existing Google Maps page - KEEP -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <!-- Temporary NAVER Maps test page -->
    <ShellContent
        Title="NAVER Map Test"
        ContentTemplate="{DataTemplate views:NaverMapTestPage}"
        Route="NaverMapTestPage" />

    <!-- TEMPORARY TEST ROUTE -->
    <ShellContent
        Title="Map Search Demo"
        ContentTemplate="{DataTemplate pages:MapSearchDemoPage}"
        Route="MapSearchDemoPage"
        IsVisible="True" />

</Shell>