<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelApp.Controls"
             xmlns:models="clr-namespace:TravelApp.Models"
             x:Class="TravelApp.MainPage">

    <Grid>
        <controls:GoogleMapView
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InitialZoom="12">
            <controls:GoogleMapView.InitialCenter>
                <models:GeoCoordinate>
                    <x:Arguments>
                        <x:Double>1.3521</x:Double>
                        <x:Double>103.8198</x:Double>
                    </x:Arguments>
                </models:GeoCoordinate>
            </controls:GoogleMapView.InitialCenter>
        </controls:GoogleMapView>
    </Grid>

</ContentPage>
