<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:TravelApp.Controls"
             xmlns:models="clr-namespace:TravelApp.Models"
             x:Class="TravelApp.MainPage">

    <Grid>
        <controls:GoogleMapView
            x:Name="MapViewControl"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            InitialZoom="12">
            <controls:GoogleMapView.InitialCenter>
                <models:GeoCoordinate>
                    <x:Arguments>
                        <x:Double>1.3521</x:Double>
                        <x:Double>103.8198</x:Double>
                    </x:Arguments>
                </models:GeoCoordinate>
            </controls:GoogleMapView.InitialCenter>
        </controls:GoogleMapView>

        <!-- Search Overlay Card -->
        <VerticalStackLayout
            Margin="16,16,16,0"
            Padding="12"
            Spacing="8"
            VerticalOptions="Start"
            BackgroundColor="#F0FFFFFF"
            MaximumWidthRequest="500">

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="0"
                    Placeholder="Search place... (e.g. Marina Bay Sands)"
                    Text="Marina Bay Sands"
                    Completed="OnSearchClicked" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    Text="Search"
                    Clicked="OnSearchClicked" />
            </Grid>

            <Label
                x:Name="StatusLabel"
                IsVisible="False"
                TextColor="DarkRed"
                FontSize="14" />

            <Border
                x:Name="ResultCard"
                IsVisible="False"
                Padding="12"
                StrokeShape="RoundRectangle 8"
                BackgroundColor="White">
                <VerticalStackLayout Spacing="4">
                    <Label
                        x:Name="PlaceNameLabel"
                        FontAttributes="Bold"
                        FontSize="16" />
                    <Label
                        x:Name="PlaceAddressLabel"
                        FontSize="14"
                        TextColor="#333333" />
                    <Label
                        x:Name="PlaceProviderLabel"
                        FontSize="12"
                        TextColor="Gray" />
                    <Button
                        x:Name="OpenDeepLinkButton"
                        Margin="0,8,0,0"
                        Text="Open in Map"
                        Clicked="OnOpenDeepLinkClicked"
                        IsVisible="False" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </Grid>

</ContentPage>
